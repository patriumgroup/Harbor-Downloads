[Unit]
Description=Harbor owner pgAdmin instance
After=network.target harbor-pgadmin.socket
Requires=harbor-pgadmin.socket

[Service]
User=harbor-pgadmin
Group=harbor-pgadmin
WorkingDirectory=/usr/local/share/harbor/database-tools
Environment=PYTHONPATH=/opt/harbor-pgadmin/lib/python3.12/site-packages/pgadmin4
Environment=HARBOR_TOOL_SSO=1
Environment=HOME=/var/lib/harbor-pgadmin
SupplementaryGroups=harbor-tools
EnvironmentFile=/etc/harbor/pgadmin.env
ExecStart=/opt/harbor-pgadmin/bin/gunicorn --workers 2 --bind unix:/run/harbor-pgadmin.sock --timeout 60 harbor_pgadmin:application
Restart=on-failure
StateDirectory=harbor-pgadmin
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
UMask=0077
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=multi-user.target
