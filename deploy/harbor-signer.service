[Unit]
Description=Harbor DKIM submission signer
After=network.target

[Service]
Type=simple
User=harbor-signer
Group=postfix
SupplementaryGroups=harbor-signer
ExecStart=/usr/local/bin/harbor-signer
Restart=on-failure
RestartSec=3
RuntimeDirectory=harbor-signer
RuntimeDirectoryMode=0750
UMask=0117
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=128M
TasksMax=32
LimitNOFILE=128

[Install]
WantedBy=multi-user.target
