[Unit]
Description=Harbor privileged service control agent
After=dbus.service
Requires=dbus.service

[Service]
Type=notify
NotifyAccess=main
User=root
ExecStart=/usr/local/bin/harbor-agent
Restart=on-failure
RestartSec=3
RuntimeDirectory=harbor-agent
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# NGINX -t opens configured IPv4/IPv6 listeners while validating a site change.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID CAP_KILL CAP_AUDIT_WRITE CAP_NET_BIND_SERVICE
# Required for the native UID transition with NoNewPrivileges + RestrictSUIDSGID.
# UID transitions clear this ambient capability before the tenant workload.
AmbientCapabilities=CAP_SETUID
SystemCallArchitectures=native
SystemCallFilter=@system-service @setuid
# FPM and NGINX configuration tests open their configured files in /var/log.
ReadWritePaths=/run/harbor-agent /etc /home /srv/harbor-sites /var/www/harbor-acme /var/lib/harbor /var/lib/harbor-dkim /var/log
# doveadm must update mailbox indexes and perform authorized Junk moves.
# Optional because local mail may never be installed on this host.
ReadWritePaths=-/var/lib/harbor-mail
StateDirectory=harbor
StateDirectoryMode=0700
MemoryMax=128M
TasksMax=16
LimitNOFILE=128

[Install]
WantedBy=multi-user.target
